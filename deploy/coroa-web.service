[Unit]
Description=Coroa — API web do painel
After=network-online.target coroa.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/faction-bot
ExecStart=/usr/bin/node src/web.js
Restart=always
RestartSec=8
TimeoutStopSec=20
KillSignal=SIGTERM
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coroa-web
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
